<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvLab19LoginTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/login_title"
        android:textSize="@dimen/title_text_size"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/title_margin_top" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilLab19Login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_login"
        app:boxBackgroundMode="outline"
        app:layout_constraintTop_toBottomOf="@id/tvLab19LoginTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/field_margin_top">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etLab19Login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilLab19Password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_password"
        app:endIconMode="password_toggle"
        app:boxBackgroundMode="outline"
        app:layout_constraintTop_toBottomOf="@id/tilLab19Login"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/field_margin_top_small">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etLab19Password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword" />
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/btnLab19Login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_login"
        android:textColor="@color/white"
        android:background="@color/flag_blue"
        app:layout_constraintTop_toBottomOf="@id/tilLab19Password"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/button_margin_top" />

    <Button
        android:id="@+id/btnLab19Register"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_register"
        android:textColor="@color/white"
        android:background="@color/flag_blue"
        app:layout_constraintTop_toBottomOf="@id/btnLab19Login"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/btnLab19SwitchLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_switch_to_linear"
        android:textColor="@color/white"
        android:background="@color/flag_red"
        app:layout_constraintTop_toBottomOf="@id/btnLab19Register"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/button_margin_top" />

    <TextView
        android:id="@+id/tvLab19AuthResult"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="@dimen/body_text_size"
        android:textColor="?android:attr/textColorPrimary"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toBottomOf="@id/btnLab19SwitchLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/button_margin_top" />
</androidx.constraintlayout.widget.ConstraintLayout>
